# Ollama must be running locally. The model name must match `ollama list`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120

# Generation settings
OLLAMA_TEMPERATURE=0.6
OLLAMA_TOP_P=0.9
MAX_HISTORY_MESSAGES=12
MAX_INPUT_CHARS=12000

# API settings (API is bound to localhost by default)
ZARA_API_HOST=127.0.0.1
ZARA_API_PORT=8000